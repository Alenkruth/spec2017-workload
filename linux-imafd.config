# Target kernel at RV64IMAFD (no C extension).
# PORTABLE selects EFI which selects RISCV_ISA_C, so enable NONPORTABLE
# to break that chain, then disable EFI and RISCV_ISA_C explicitly.
CONFIG_NONPORTABLE=y
# CONFIG_EFI is not set
# CONFIG_EFI_STUB is not set
# CONFIG_EFI_PARTITION is not set
# CONFIG_RISCV_ISA_C is not set
